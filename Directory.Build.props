<Project>
  <!-- .NET here serves the desktop bridge only: ScoutRemote.Domain (protocol model)
       and ScoutRemote.Bridge (MCP helper host). The mobile client is Kotlin — see
       src/mobile and docs/mobile-framework-kotlin.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.dev/schemas/command.schema.json",
  "title": "Remote command (commands/inbox/{commandId}.json)",
  "description": "Mobile-to-bridge command. Immutable once written; idempotent via processed receipts; must not execute after expiresUtc. Spec section 7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "conversationId", "type", "createdUtc", "expiresUtc", "requestedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; globally unique, sortable, never reused (replay control)."
    },
    "conversationId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["message", "request_status", "request_summary", "request_artifact", "cancel_request"]
    },
    "createdUtc": { "type": "string", "format": "date-time" },
    "expiresUtc": { "type": "string", "format": "date-time" },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entraObjectId"],
      "properties": {
        "entraObjectId": { "type": "string", "minLength": 1 }
      }
    },
    "text": {
      "type": "string",
      "maxLength": 8000,
      "description": "Untrusted natural-language input; the bridge must treat this as data, never as policy."
    },
    "targetCommandId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "For cancel_request: the command whose cancellation is requested (best effort only)."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWorkIqCalls": { "type": "integer", "minimum": 0 },
        "allowSensitiveActions": {
          "type": "boolean",
          "const": false,
          "description": "MVP: sensitive actions always require desktop approval; this flag cannot grant them."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "message" } }, "required": ["type"] },
      "then": { "required": ["text"] }
    },
    {
      "if": { "properties": { "type": { "const": "cancel_request" } }, "required": ["type"] },
      "then": { "required": ["targetCommandId"] }
    }
  ]
}
